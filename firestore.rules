rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Firebase exposes this claim only after the inbox owner has opened the
    // verification link. Google identities already provide a verified email.
    function verifiedUser() { return signedIn() && request.auth.token.email_verified == true; }
    function isMe(uid)  { return signedIn() && request.auth.uid == uid; }
    function isVerifiedMe(uid) { return verifiedUser() && request.auth.uid == uid; }

    // ── Users ────────────────────────────────────────────────────────────────
    // Profiles are public: leaderboards, player search and puzzle boards are
    // all readable without an account, which is what makes guest play and a
    // signed-out visit worth anything. Nothing private is stored on the doc —
    // no email, no auth material — and writes stay owner-only.
    match /users/{uid} {
      allow read:  if true;
      allow write: if isVerifiedMe(uid);
    }

    // Public result history powers the profile graph; only its owner can write,
    // reset, or remove their entries.
    match /users/{uid}/history/{historyId} {
      allow read: if true;
      allow write: if isVerifiedMe(uid);
    }

    // ── Saved source, solve history, and public solution shares ─────────────
    // A player owns their private solution library. Public visibility only occurs
    // through an explicit immutable share snapshot in `sharedSolutions`.
    match /users/{uid}/solutions/{archetypeId} {
      allow read, write: if isVerifiedMe(uid);
    }

    match /users/{uid}/solutions/{archetypeId}/history/{entryId} {
      allow read, write: if isVerifiedMe(uid);
    }

    match /sharedSolutions/{shareId} {
      allow read: if true;
      allow create: if verifiedUser() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if verifiedUser() && resource.data.ownerUid == request.auth.uid;
    }

    // ── Username reservations (uniqueness index) ─────────────────────────────
    match /usernames/{name} {
      allow read:   if true;
      allow create: if verifiedUser() && request.resource.data.uid == request.auth.uid;
      allow delete: if verifiedUser() && resource.data.uid == request.auth.uid;
    }

    // ── Friend requests ──────────────────────────────────────────────────────
    // The inbox copy lives under the recipient; a mirror under the sender lets
    // the sender's UI show "Pending" without reading someone else's inbox.
    match /friendRequests/{toUid}/from/{fromUid} {
      allow read:   if isVerifiedMe(toUid) || isVerifiedMe(fromUid);
      allow create: if isVerifiedMe(fromUid);
      allow delete: if isVerifiedMe(toUid) || isVerifiedMe(fromUid);
    }

    match /friendRequests/{fromUid}/sent/{toUid} {
      allow read:   if isVerifiedMe(fromUid);
      allow create: if isVerifiedMe(fromUid);
      allow delete: if isVerifiedMe(fromUid) || isVerifiedMe(toUid);
    }

    // ── Friends list ─────────────────────────────────────────────────────────
    match /friends/{uid}/list/{friendUid} {
      allow read:  if verifiedUser();
      allow write: if isVerifiedMe(uid) || isVerifiedMe(friendUid);
    }

    // ── Notifications ────────────────────────────────────────────────────────
    match /notifications/{uid}/items/{notifId} {
      allow read: if isVerifiedMe(uid) || (verifiedUser() && resource.data.fromUid == request.auth.uid);
      allow update: if isVerifiedMe(uid);
      allow delete: if isVerifiedMe(uid) || (verifiedUser() && resource.data.fromUid == request.auth.uid);
      allow create: if verifiedUser();
    }

    // ── Conversations ───────────────────────────────────────────────────────
    match /conversations/{convId} {
      // Allow a signed-in user to `get` a doc (needed to check existence before
      // creating). Listing/querying conversations is allowed for signed-in users
      // as well so clients can watch their conversation list.
      allow get, list: if verifiedUser();

      // Creating a conversation must include the creator as a participant.
      allow create: if verifiedUser() && request.auth.uid in request.resource.data.participants;

      // Updates and deletes are only allowed to participants.
      allow update, delete: if verifiedUser() && request.auth.uid in resource.data.participants;
    }

    match /conversations/{convId}/messages/{msgId} {
      // Reads, creates, and deletion during account cleanup are allowed only to
      // participants of the owning conversation.
      allow read, create, delete: if verifiedUser() &&
        exists(/databases/$(database)/documents/conversations/$(convId)) &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
    }

    // ── Presence ─────────────────────────────────────────────────────────────
    match /presence/{uid} {
      allow read: if verifiedUser();
      allow create, update, delete: if isVerifiedMe(uid);
    }

    // ── Matchmaking lobby ────────────────────────────────────────────────────
    // Verified accounts must be able to scan the lobby for an opponent.
    // The initiator writes "matched" onto the opponent's doc in one batch,
    // so update is open to any verified user.
    match /matchmaking_lobby/{uid} {
      allow read:   if verifiedUser();
      allow create: if isVerifiedMe(uid);
      allow update: if verifiedUser();
      allow delete: if isVerifiedMe(uid);
    }

    // ── Duels ────────────────────────────────────────────────────────────────
    match /duels/{duelId} {
      allow read:   if verifiedUser();
      allow create: if verifiedUser();
      allow update, delete: if verifiedUser() &&
        (request.auth.uid == resource.data.player1.uid ||
         request.auth.uid == resource.data.player2.uid);
    }

    // ── Friend challenges ────────────────────────────────────────────────────
    match /challenges/{challengeId} {
      allow read:   if verifiedUser() &&
        (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow create: if verifiedUser() && request.auth.uid == request.resource.data.fromUid;
      allow update, delete: if verifiedUser() &&
        (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
    }

    // ── Training Grounds puzzle times (one doc per user per puzzle) ──────────
    // Doc id is "{archetypeId}__{uid}" so the owner check is cheap. Public read
    // for the same reason as users: the per-puzzle boards are a public feature.
    match /puzzleTimes/{recordId} {
      allow read:   if true;
      allow write:  if verifiedUser() && request.resource.data.uid == request.auth.uid;
      allow delete: if verifiedUser() && resource.data.uid == request.auth.uid;
    }

    // Guests never reach Firestore at all — their unranked rating, best times
    // and discovered puzzles live in localStorage (see public/js/local.js).
  }
}
